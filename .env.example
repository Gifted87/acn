# ACN Environment Variables Template
# Copy this file to .env and fill in the values

# --- AI Backend Keys ---
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Alibaba DashScope (OpenAI Compatible) API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# --- System Configuration ---
# Phoenix Secret Key Base (Generate with: mix phx.gen.secret)
SECRET_KEY_BASE=VGhpcyBpcyBhIHNlY3JldCBrZXkgYmFzZSBmYWxsYmFjayBmb3IgZGV2

# Phoenix LiveView Signing Salt (Generate with: mix phx.gen.secret 32)
LIVE_VIEW_SALT=acn_live_salt_fallback

# ACMS Backend Configuration
CMS_URL=http://localhost:4000
CMS_API_KEY=your_cms_api_key_here

# Ollama Configuration (if using local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# --- Node Configuration ---
# MNESIA_DIR=priv/data/mnesia_node
# SEED_NODES=node1@host,node2@host
